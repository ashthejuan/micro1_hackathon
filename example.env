# OpenAI-compatible endpoint config (works with Ollama, vLLM, LiteLLM, OpenRouter, ...)
OPENAI_API_KEY=sk-...your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Set LIVE=1 to call the real endpoint and record fixtures into fixtures/llm_cache.jsonl.
# Leave empty for offline replay/fallback mode (no API key needed).
LIVE=
